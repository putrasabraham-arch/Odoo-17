<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Wrapper -->
    <template id="report_bukti_penerimaan">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="custom_receipt_bukti_penerimaan_futake.report_bukti_penerimaan_document"/>
            </t>
        </t>
    </template>

    <!-- Document -->
    <template id="report_bukti_penerimaan_document">
        <div class="page" style="font-size: 12px;">

            <!-- LOGO -->
            <div style="text-align: center; padding-top: 4px;">
                <img t-if="o.company_id.logo"
                     t-att-src="image_data_uri(o.company_id.logo)"
                     style="max-height: 80px; max-width: 250px;"/>
            </div>

            <!-- JUDUL -->
            <h2 style="text-align: center; font-weight: bold; margin-top: 8px; margin-bottom: 16px;">
                BUKTI PENERIMAAN BARANG
            </h2>

            <!-- DATA HEADER -->
            <table width="100%" style="margin-bottom: 10px; vertical-align: top;">
                <tr>
                    <td width="50%" style="padding: 4px 0;">
                        <strong>Tanggal:</strong>
                        <span t-if="o.date_done"
                              t-field="o.date_done"
                              t-options='{"format": "dd/MM/yyyy"}'/>
                    </td>
                    <td width="50%" style="padding: 4px 0;">
                        <strong>Nama Vendor / Supplier:</strong>
                        <span t-field="o.partner_id.name"/>
                    </td>
                </tr>
                <tr>
                    <td width="50%" style="padding: 4px 0;">
                        <strong>No. SPK / PO:</strong>
                        <span t-field="o.origin"/>
                    </td>
                    <td width="50%" style="padding: 4px 0;">
                        <strong>Referensi:</strong>
                        <span t-esc="o.receipt_reference or o.receipt_vendor_ref or ''"/>
                    </td>
                </tr>
            </table>

            <!-- TABEL BARANG -->
            <table width="100%" cellpadding="6" style="border-collapse: collapse;">
                <thead>
                    <tr style="border-top: 1px solid black; border-bottom: 1px solid black;">
                        <th style="text-align: center; width: 5%; padding: 6px;">No.</th>
                        <th style="text-align: left; width: 45%; padding: 6px;">Nama Barang</th>
                        <th style="text-align: center; width: 15%; padding: 6px;">Qty</th>
                        <th style="text-align: left; width: 35%; padding: 6px;">Keterangan</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-set="lines"
                       t-value="o.move_ids_without_package.filtered(lambda m: m.state != 'cancel')"/>
                    <tr t-foreach="lines" t-as="move" style="border-bottom: 1px solid black;">
                        <td style="text-align: center; vertical-align: top;"
                            t-esc="move_index + 1"/>
                        <td style="vertical-align: top; padding: 6px;">
                            <span t-field="move.product_id.display_name"/>
                        </td>
                        <td style="vertical-align: top; padding: 6px; text-align: center;">
                            <span t-esc="'%g' % move.quantity"/>
                            <span t-if="move.product_uom" t-esc="move.product_uom.name"/>
                        </td>
                        <td style="vertical-align: top; padding: 6px;"
                            t-esc="move.receipt_remark or ''"/>
                    </tr>
                </tbody>
            </table>

            <!-- CATATAN -->
            <div style="margin-top: 14px;">
                <strong>Catatan:</strong>
                <div style="min-height: 80px; padding-top: 4px; border-bottom: 1px solid black;">
                    <span t-field="o.receipt_note"/>
                </div>
            </div>

            <!-- TANDA TANGAN -->
            <table width="100%" cellpadding="6" style="border-collapse: collapse; margin-top: 16px;">
                <thead>
                    <tr style="border-top: 1px solid black; border-bottom: 1px solid black;">
                        <th style="width: 33.33%; text-align: center; padding: 6px;">Diserahkan Oleh</th>
                        <th style="width: 33.33%; text-align: center; padding: 6px; border-left: 1px solid black;">Diterima Oleh</th>
                        <th style="width: 33.33%; text-align: center; padding: 6px;">Mengetahui</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <!-- Area tanda tangan manual -->
                        <td style="height: 110px; vertical-align: bottom; text-align: center; padding: 6px;">
                            <span t-esc="o.delivered_by or ''"/>
                        </td>
                        <td style="height: 110px; vertical-align: bottom; text-align: center; padding: 6px; border-left: 1px solid black;">
                            <span t-esc="o.received_by or ''"/>
                        </td>
                        <td style="height: 110px; vertical-align: bottom; text-align: center; padding: 6px;">
                            <span t-esc="o.approved_by or ''"/>
                        </td>
                    </tr>
                </tbody>
            </table>
            <div style="border-top: 1px solid black;"/>

        </div>
    </template>

</odoo>